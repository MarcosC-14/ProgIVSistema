<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Certificado de aprobacion</title>

    <style>
       @page {
            size: A4 landscape;
            margin: 0;
        }

        body{
            font-family: 'Times New Roman', Times, serif;
            margin: 0;
            padding: 0;
            background-color: #fcfbf7; /* Un tono marfil/crema muy sutil en lugar de blanco puro */
            -webkit-print-color-adjust: exact;
        }

        /* Contenedor principal del diploma */
        .diploma-container {
            background-color: #ffffff;
            box-sizing: border-box;
            position: relative;
            overflow: hidden;
            text-align: center;
            margin-bottom: 30px;
            border: 20px solid #003366;
            
        }
        
        .diploma-container h1{
            font-size: 42px;
            margin-top: 50px;
            margin-bottom: 10px;
            letter-spacing: 10px;
            font-weight: 700;
        }
        
        .diploma-container p{
            margin: 5px 0;
        }

        .logo-container {
        text-align: center;
        margin-top: 20px;
        margin-bottom: 0px;
        }

        .logo-img {
        max-width: 150px; 
        height: auto;
        }

        .border-inner {
            position: absolute;
            top: 35px;
            left: 35px;
            right: 35px;
            bottom: 35px;
            border: 2px solid #c5a059; 
            pointer-events: none;
        }

    </style>

</head>
<body>
    <div class="diploma-container">
        <div class="border-outer"></div>
        <div class="border-inner"></div>

        <div class="logo-container">
            <img src="{{logoBase64}}" alt="Logo Institucional" class="logo-img">
        </div>
        <h1>CERTIFICADO DE APROBACIÓN</h1>
        <div class="label">Otorgado a:</div>
        <div class="divider"></div>
        <h2 class="student-name">{{NOMBRES}} {{APELLIDOS}}</h2>
        <div class="student-doc">Documento: {{documento}}</div>
        <p class="couse-text">Por su participacióm y aprobacion en el curso:</p>
        <h3 class="course-name">{{NOMBRE_DEL_CURSO}}</h3>
        <div class="course-info"><strong>Id de incripcion: </strong>{{id_inscripcion}}.</div>
        <div class="couse-info"><strong>Fecha de emisión:</strong>{{Día}} de {{Mes}} de {{Año}}.</div>
    </div>
</body>    
</html>